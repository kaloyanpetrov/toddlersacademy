RewriteEngine On

# Force HTTPS and drop www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://toddlersacademy.eu/$1 [L,R=301]

# /index.html -> /  and  /bg/index.html -> /bg/  (only for direct requests, so no loop)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://toddlersacademy.eu/ [L,R=301]
RewriteCond %{THE_REQUEST} \s/bg/index\.html[\s?] [NC]
RewriteRule ^bg/index\.html$ https://toddlersacademy.eu/bg/ [L,R=301]

AddType video/mp4 .mp4

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
    ExpiresByType video/webm "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
